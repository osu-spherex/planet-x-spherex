# Copy to .env.local for local development (role C, deploy/README.md). On Vercel set the same
# variable in Project Settings -> Environment Variables.

# The FastAPI backend: /api/cube (any coordinate, ~1-2 min, poll while HTTP 202) and later /api/measure.
# Local:      http://127.0.0.1:8000   (.venv/Scripts/python -m uvicorn backend.app:app --port 8000)
# Production: https://osu-spherex-api.onrender.com   (free plan: sleeps after 15 min, ~1 min to wake)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# The 5 demo cubes do NOT need the backend: they are served by the frontend itself at
# /cubes/<obj>/<band>/cube.json (copied from data/cubes/ by deploy/copy-cubes.mjs before next build;
# locally run `node deploy/copy-cubes.mjs` once from the repo root).
